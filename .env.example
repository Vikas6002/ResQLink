# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=resqlink
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Optimization defaults
OPT_ETA_WEIGHT=0.35
OPT_DISTANCE_WEIGHT=0.25
OPT_CAPABILITY_WEIGHT=0.15
OPT_EQUIPMENT_WEIGHT=0.15
OPT_WORKLOAD_WEIGHT=0.10
OPT_AVG_SPEED_KMH=40

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api
